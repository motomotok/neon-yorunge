rules_version = '2';

// Cloud Functions YOK (Blaze planına girmeden, ücretsiz Spark'ta kalmak
// için bilinçli tercih — bkz. src/cloud-account.js başındaki not). Bu
// yüzden oyuncu kendi dokümanına doğrudan yazabiliyor; bu SADECE bir
// cihazlar-arası yedekleme/geri-yükleme deposu, elmas/ödül VERMEZ — yani
// bir kullanıcının kendi belgesine ne yazdığı, bugün zaten localStorage'ı
// değiştirebilen bir kullanıcının elinden daha fazlasını almıyor (aynı
// güven seviyesi, yeni bir açık değil). Herkes sadece KENDİ belgesini
// okuyup yazabilir, başkasınınkine asla erişemez.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Günün Seti skor tablosu (bkz. src/leaderboard.js, www/game/dailyset.js).
    // Herkes okuyabilir; her oyuncu yalnız kendi belgesini yazar. Ad oyunun
    // ürettiği takma addır (harf/rakam), toplam makul sınırda ve gün içinde
    // yalnız artabilir. Silme yok.
    // Oyuncunun seçtiği isim: harf (her dil), rakam, boşluk, _ . - ; 3-16 karakter.
    function nameOk(n) {
      return n is string && n.matches('^[\\p{L}\\p{N} _.-]{3,16}$');
    }
    // Global Sıralama (Klasik): 'all' ya da haftalık 'w2026-43'.
    match /lb/{board}/scores/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && (board == 'all' || board.matches('^w20[0-9]{2}-[0-5][0-9]$'))
        && request.resource.data.keys().hasOnly(['name', 'score', 'heat', 'ts'])
        && nameOk(request.resource.data.name)
        && request.resource.data.score is number
        && request.resource.data.score >= 0 && request.resource.data.score <= 2000000
        && request.resource.data.heat is int
        && request.resource.data.heat >= 0 && request.resource.data.heat <= 5
        && request.resource.data.ts == request.time
        && (resource == null || request.resource.data.score >= resource.data.score);
    }

    // Düello kayıtları: herkes okur; oyuncu yalnız kendi adına, yalnız yeni
    // kayıt ekler (düzenleme/silme yok). Boyutlar sınırlı.
    match /duelGhosts/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['v', 'uid', 'seed', 'name', 'rating', 'theme', 'skin', 'perks', 's', 'a', 'died', 'score', 'ts'])
        && nameOk(request.resource.data.name)
        && request.resource.data.seed is int
        && request.resource.data.rating is int && request.resource.data.rating >= 0 && request.resource.data.rating <= 4000
        && request.resource.data.s is list && request.resource.data.s.size() <= 820
        && request.resource.data.a is list && request.resource.data.a.size() <= 40
        && request.resource.data.perks is list && request.resource.data.perks.size() <= 3
        && request.resource.data.score is number && request.resource.data.score <= 2000000
        && request.resource.data.ts == request.time;
    }

    // Yalnız dün/bugün/yarın (saat dilimi payıyla) yazılabilir: geçmiş ya da
    // ileri tarihli günlere (saat ileri alınarak) kayıt atılamaz.
    function dayNear(day) {
      let d = timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10]));
      return d > request.time - duration.value(2, 'd') && d < request.time + duration.value(1, 'd');
    }
    match /dset/{day}/scores/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && dayNear(day)
        && request.resource.data.keys().hasOnly(['name', 'total', 'runs', 'ts'])
        && nameOk(request.resource.data.name)
        && request.resource.data.total is number
        && request.resource.data.total >= 0 && request.resource.data.total <= 300000
        && request.resource.data.runs is int
        && request.resource.data.runs >= 1 && request.resource.data.runs <= 500
        && request.resource.data.ts == request.time
        && (resource == null || request.resource.data.total >= resource.data.total);
    }
  }
}
