rules_version = '2';

// Cloud Functions YOK (Blaze planına girmeden, ücretsiz Spark'ta kalmak
// için bilinçli tercih — bkz. src/cloud-account.js başındaki not). Bu
// yüzden oyuncu kendi dokümanına doğrudan yazabiliyor; bu SADECE bir
// cihazlar-arası yedekleme/geri-yükleme deposu, elmas/ödül VERMEZ — yani
// bir kullanıcının kendi belgesine ne yazdığı, bugün zaten localStorage'ı
// değiştirebilen bir kullanıcının elinden daha fazlasını almıyor (aynı
// güven seviyesi, yeni bir açık değil). Herkes sadece KENDİ belgesini
// okuyup yazabilir, başkasınınkine asla erişemez.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Günün Seti skor tablosu (bkz. src/leaderboard.js, www/game/dailyset.js).
    // Herkes okuyabilir; her oyuncu yalnız kendi belgesini yazar. Ad oyunun
    // ürettiği takma addır (harf/rakam), toplam makul sınırda ve gün içinde
    // yalnız artabilir. Silme yok.
    // Oyuncunun seçtiği isim: harf (her dil), rakam, boşluk, _ . - ; 3-16 karakter.
    function nameOk(n) {
      return n is string && n.matches('^[\\p{L}\\p{N} _.-]{3,16}$');
    }
    // Global Sıralama (Klasik): 'all' ya da haftalık 'w2026-43'.
    match /lb/{board}/scores/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && (board == 'all' || board.matches('^w20[0-9]{2}-[0-5][0-9]$'))
        && request.resource.data.keys().hasOnly(['name', 'score', 'heat', 'ts'])
        && nameOk(request.resource.data.name)
        && request.resource.data.score is number
        && request.resource.data.score >= 0 && request.resource.data.score <= 2000000
        && request.resource.data.heat is int
        && request.resource.data.heat >= 0 && request.resource.data.heat <= 5
        && request.resource.data.ts == request.time
        && (resource == null || request.resource.data.score >= resource.data.score);
    }

    // Düello: her oyuncunun en son maçı, belge kimliği = uid (üzerine yazılır).
    // Herkes okur (rakip olarak oynatılır); yalnız sahibi yazar. Boyutlar sınırlı.
    match /duels/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'seed', 'name', 'mmr', 'b', 'd', 'lp', 'theme', 'skin', 'perks', 's', 'a', 'died', 'score', 't'])
        && nameOk(request.resource.data.name)
        && request.resource.data.seed is int
        && request.resource.data.mmr is int && request.resource.data.mmr >= 0 && request.resource.data.mmr <= 4000
        && request.resource.data.b is int && request.resource.data.b == math.floor(request.resource.data.mmr / 100)
        && request.resource.data.d is int && request.resource.data.d >= 0 && request.resource.data.d <= 20
        && request.resource.data.lp is int && request.resource.data.lp >= 0 && request.resource.data.lp <= 5000
        && request.resource.data.theme is string && request.resource.data.theme.size() <= 24
        && request.resource.data.skin is string && request.resource.data.skin.size() <= 24
        && request.resource.data.s is list && request.resource.data.s.size() <= 820
        && request.resource.data.a is list && request.resource.data.a.size() <= 40
        && request.resource.data.perks is list && request.resource.data.perks.size() <= 3
        && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 2000000
        && request.resource.data.t == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Yalnız dün/bugün/yarın (saat dilimi payıyla) yazılabilir: geçmiş ya da
    // ileri tarihli günlere (saat ileri alınarak) kayıt atılamaz.
    function dayNear(day) {
      let d = timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10]));
      return d > request.time - duration.value(2, 'd') && d < request.time + duration.value(1, 'd');
    }
    match /dset/{day}/scores/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && dayNear(day)
        && request.resource.data.keys().hasOnly(['name', 'total', 'runs', 'ts', 'lg'])
        && (!('lg' in request.resource.data) || request.resource.data.lg in ['u', 'bronze', 'silver', 'gold', 'platinum', 'diamond', 'master'])
        && nameOk(request.resource.data.name)
        && request.resource.data.total is number
        && request.resource.data.total >= 0 && request.resource.data.total <= 6000000
        && request.resource.data.runs is int
        && request.resource.data.runs >= 1 && request.resource.data.runs <= 500
        && request.resource.data.ts == request.time
        && (resource == null || request.resource.data.total >= resource.data.total);
    }
    // ---- Admin paneli (admin/index.html, Firebase Hosting) ----
    // Yalnız geliştiricinin Google hesabı (e-posta doğrulanmış, Google ile
    // girilmiş). Başka biri paneli açsa bile hiçbir şey okuyamaz/yazamaz.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'aliaslan625@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Oyuncu özeti (src/telemetry.js) — yalnız KVKK istatistik izni veren
    // oyuncu yazar; izni geri alınca/hesap silinince siler. Okuma: admin.
    match /players/{uid} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'ver', 'lang', 'plat', 'games', 'best', 'mins', 'mmr', 'tier', 'duels', 'gems', 'notes', 'lvl', 'linked', 'noads', 'pass', 'on', 'since', 'day', 'dayGames', 'dayMins', 'ft', 'runs', 'days', 'fps', 'mfps', 'dev', 'gpu', 'q', 'ram', 'boot', 'lastSeen'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 12
        && request.resource.data.tier is string && request.resource.data.tier.size() <= 16
        && request.resource.data.games is int && request.resource.data.best is int
        && request.resource.data.mins is int && request.resource.data.mmr is int
        && request.resource.data.lastSeen == request.time;
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }

    // Oyun kodu hataları (crash-report.js → telemetry.js). Herkes yalnız
    // kendi adına ekler; okuma/silme admin.
    match /errors/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['msg', 'stack', 'ver', 'plat', 'uid', 'scr', 'ua', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 3000
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
        && request.resource.data.ts == request.time;
    }

    // Hediyeler: admin gönderir; oyuncu yalnız kendininkileri okur ve
    // yalnız "alındı" işaretleyebilir (miktar/tür değiştirilemez).
    match /gifts/{uid}/items/{gid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == uid
        && resource.data.claimed == false
        && request.resource.data.claimed == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimedAt']));
    }
    // Admin paneli "Raporlar" (Ads / AdMob / Play / App Store özeti). Bilgisayardaki
    // toplayıcı (Otomasyonlar/pasla-play-reports-mcp/scripts/dash-collect.mjs)
    // tek belgeyi gizli anahtarla yazar; kuralda yalnız anahtarın sha256 özeti var.
    match /dash/{id} {
      allow read: if isAdmin();
      allow create, update: if id == 'main'
        && request.resource.data.keys().hasOnly(['k', 'json', 'at'])
        && request.resource.data.k is string
        && hashing.sha256(request.resource.data.k).toHexString().lower() == '748a196758b3c2a6dd1dad06cd69b5334cb5e9f116ada600beb9fe7339ca49de'
        && request.resource.data.json is string
        && request.resource.data.json.size() < 800000;
    }
    match /giftlog/{gid} {
      allow read, write: if isAdmin();
    }
  }
}
