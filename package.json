{
  "name": "beat-orbit",
  "version": "2.42.5",
  "description": "Beat Orbit - tarayıcı tabanlı refleks/arcade oyunu ve Android uygulaması",
  "private": true,
  "scripts": {
    "serve": "npx serve www -l 8080",
    "build:ads": "esbuild src/native-ads.js --bundle --format=iife --outfile=www/native-ads-bundle.js",
    "build:3d": "esbuild src/render3d/index.js --bundle --minify --format=iife --target=es2019 --outfile=www/render3d-bundle.js",
    "build:cloud": "esbuild src/cloud-account.js --bundle --minify --format=iife --target=es2019 --outfile=www/firebase-bundle.js",
    "build:crash": "esbuild src/crash-report.js --bundle --minify --format=iife --target=es2019 --outfile=www/crash-bundle.js",
    "build": "npm run build:ads && npm run build:3d && npm run build:cloud && npm run build:crash && npm run build:notify && npm run build:update",
    "cap:sync": "npm run build && cap sync",
    "android:open": "cap open android",
    "android:debug": "cd android && gradlew.bat assembleDebug",
    "ios:open": "cap open ios",
    "build:notify": "esbuild src/notify.js --bundle --minify --format=iife --target=es2019 --outfile=www/notify-bundle.js",
    "build:update": "esbuild src/app-update.js --bundle --minify --format=iife --target=es2019 --outfile=www/app-update-bundle.js"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.2.0",
    "@capacitor-firebase/authentication": "^6.3.1",
    "@capacitor-firebase/crashlytics": "^6.3.1",
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.2",
    "@capacitor/local-notifications": "^6.1.3",
    "@capawesome/capacitor-app-update": "^6.1.0",
    "@openforge/capacitor-game-connect": "^5.0.2",
    "cordova-plugin-purchase": "^13.18.0",
    "firebase": "^12.19.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "esbuild": "^0.28.1"
  }
}
